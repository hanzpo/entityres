{
  "config": {
    "entity": "company",
    "fields": {
      "name": { "compare": "string", "semantic": true, "merge": "judge" },
      "domain": { "compare": "exact", "normalize": "email" },
      "phone": { "compare": "exact", "normalize": "digits" },
      "city": { "compare": "string" },
      "employees": { "compare": "number", "merge": "newest" },
      "tags": { "compare": "none", "merge": "union" }
    },
    "keys": ["domain"],
    "blocking": [
      { "field": "name", "transform": "tokens" },
      { "field": "phone", "transform": "digits" },
      { "field": "city" }
    ],
    "vetoes": [{ "rule": "same_source" }, { "rule": "numbers_differ", "field": "name" }],
    "sources": ["registry", "crm", "web"],
    "merge": { "updated_field": "updated" }
  },
