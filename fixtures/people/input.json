      "email": { "compare": "exact", "normalize": "email" },
      "phone": { "compare": "exact", "normalize": "digits" },
      "city": { "compare": "string" },
      "dob": { "compare": "exact", "normalize": "exact" },
      "title": { "compare": "none", "merge": "newest" }
